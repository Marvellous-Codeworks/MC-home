# GitHub — read-only, used for public stats on product pages (optional)
GITHUB_TOKEN=

# GitHub — fine-grained PAT, "Issues: write" scope, limited to gioxx/MarvellousSuspender
GITHUB_ISSUES_TOKEN=

# Resend — API key for sending report confirmation emails
RESEND_API_KEY=

# Secret used to HMAC-sign the pending-report confirmation link (any long random string)
REPORT_TOKEN_SECRET=

# Absolute origin used to build links in emails (e.g. https://marvellouscode.works)
SITE_URL=
